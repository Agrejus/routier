{
    "name": "@routier/devtools",
    "version": "0.1.0",
    "description": "In-page devtools for inspecting Routier data stores",
    "private": false,
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist/**/*",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build:types": "tsc -p tsconfig.types.json",
        "build": "vite build && npm run build:types",
        "tsc": "tsc --noEmit -p tsconfig.json",
        "lint": "oxlint . --ignore-pattern \"**/*.test.*\""
    },
    "peerDependencies": {
        "@routier/core": ">=0.8.0",
        "@routier/datastore": ">=0.4.2"
    },
    "dependencies": {
        "preact": "^10.27.2"
    },
    "devDependencies": {
        "typescript": "^5.2.2",
        "vite": "^5.0.8"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./production": {
            "types": "./dist/production.d.ts",
            "import": "./dist/production.js",
            "require": "./dist/production.cjs"
        }
    },
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Agrejus/routier.git",
        "directory": "devtools"
    }
}
