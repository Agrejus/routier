{
    "name": "routier-collection",
    "version": "1.0.0",
    "main": "index.js",
    "private": true,
    "workspaces": [
        "architecture",
        "core",
        "datastore",
        "react",
        "plugins/*",
        "test-utils",
        "sync-server",
        "e2e",
        "stress",
        "benchmark"
    ],
    "scripts": {
        "build": "npm run build -w @routier/core -w @routier/memory-plugin -w @routier/sql-plugin-core && npm run build --workspaces --if-present",
        "typecheck": "npm run tsc --workspaces --if-present",
        "build:core": "cd core && npm run tsc",
        "build:routier": "cd routier && npm run tsc",
        "sync:examples": "node scripts/sync-doc-examples.mjs",
        "extract:doc-code": "node scripts/extract-doc-code.mjs",
        "docs:prepare": "npm run extract:doc-code && npm run sync:examples",
        "docs:fix-includes": "node scripts/fix-capture-includes.mjs",
        "bump": "node scripts/bump-version.mjs",
        "benchmark": "tsx --tsconfig benchmark/tsconfig.json benchmark/src/run.ts",
        "typedoc": "typedoc",
        "lint": "npm run lint --workspaces --if-present && oxlint . --ignore-pattern \"docs/**\" --ignore-pattern \"examples/**\" --ignore-pattern \"scripts/**\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\" --ignore-pattern \"**/*.mjs\"",
        "lint:fix": "oxlint . --fix --fix-suggestions --ignore-pattern \"docs/**\" --ignore-pattern \"examples/**\" --ignore-pattern \"scripts/**\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\" --ignore-pattern \"**/*.mjs\"",
        "format:oxfmt": "oxfmt .",
        "format:check:oxfmt": "oxfmt . --check",
        "oxfmt": "oxfmt . --check",
        "mutate:expressions": "stryker run stryker/expressions.mjs",
        "mutate:codegen": "stryker run stryker/codegen.mjs",
        "mutate:plugins": "stryker run stryker/plugins.mjs",
        "mutate:replication": "stryker run stryker/replication.mjs",
        "mutate:collections": "stryker run stryker/collections.mjs",
        "mutate:datastore": "stryker run stryker/datastore.mjs",
        "mutate:incremental": "stryker run stryker/expressions.mjs --incremental",
        "test:e2e": "jest --selectProjects e2e",
        "test:e2e:containers": "E2E_CONTAINERS=1 jest --selectProjects e2e",
        "test:stress": "STRESS=1 jest --selectProjects stress",
        "test:stress:containers": "STRESS=1 E2E_CONTAINERS=1 jest --selectProjects stress",
        "benchmark:update": "tsx --tsconfig benchmark/tsconfig.json benchmark/src/run.ts --update-baseline",
        "test": "jest",
        "release:pack-check": "node scripts/pack-check.mjs",
        "release:readme-check": "node scripts/validate-package-readmes.mjs",
        "release:consumer-check": "node scripts/consumer-check.mjs",
        "test:browser": "node e2e/browser/run.mjs"
    },
    "author": "",
    "license": "MIT",
    "description": "",
    "dependencies": {
        "ts-node": "^10.9.2"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "@aws-sdk/s3-request-presigner": "^3.700.0",
        "@babel/preset-env": "^7.28.3",
        "@libsql/client": "^0.17.4",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/jest-runner": "^9.6.1",
        "@testcontainers/mongodb": "^12.1.0",
        "@testcontainers/mysql": "^12.1.0",
        "@testcontainers/postgresql": "^12.0.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^29.5.12",
        "@types/react": "^19.2.18",
        "fast-check": "^4.9.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.4.1",
        "miniflare": "^4.20260730.0",
        "mongodb": "^7.5.0",
        "oxfmt": "^0.36.0",
        "oxlint": "^1.51.0",
        "pouchdb-adapter-http": "^9.0.0",
        "pouchdb-adapter-memory": "^9.0.0",
        "pouchdb-core": "^9.0.0",
        "pouchdb-mapreduce": "^9.0.0",
        "pouchdb-replication": "^9.0.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "testcontainers": "^12.0.4",
        "ts-jest": "^29.1.2",
        "tsx": "^4.23.1",
        "typedoc": "^0.28.14",
        "typedoc-plugin-markdown": "^4.9.0"
    }
}
