# Playwright MCP page snapshots — debugging artifacts from browser-driven
# stress runs, regenerated on every session. Never part of the source tree.
.playwright-mcp/

# Generated by e2e/browser/build.mjs. A whole directory, not a pattern: an earlier
# `e2e/browser/[0-9a-f]*.js` silently matched `app.js`, which is source.
e2e/browser/dist/
e2e/browser/transfer/build/

# SQLite databases written by tests. The plugin takes a file path, and the suites
# name one per test with a uuid, so a run that fails before teardown leaves them
# in whatever directory jest was started from. Teardown removes them; this is so a
# run that dies half way cannot put 182 of them in a commit.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
