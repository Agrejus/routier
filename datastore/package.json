{
    "name": "@routier/datastore",
    "version": "0.4.0",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "source": "./src/index.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:bundle": "node ../scripts/clean-dist.mjs && rspack build",
        "build": "npm run build:bundle && npm run build:types",
        "tsc": "tsc --noEmit",
        "test": "jest",
        "lint": "oxlint . --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\" --ignore-pattern \"**/*.mjs\""
    },
    "sideEffects": false,
    "files": [
        "dist/**/*",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*",
        "README.md",
        "LICENSE"
    ],
    "author": "James DeMeuse <james.demeuse@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Agrejus/routier.git",
        "directory": "datastore"
    },
    "keywords": [
        "orm",
        "typescript",
        "typesafe",
        "data store",
        "datastore",
        "data abstraction",
        "data modeling",
        "schema",
        "query builder",
        "expressions",
        "change tracking",
        "computed properties",
        "live queries",
        "offline-first",
        "sync",
        "replication",
        "conflict resolution",
        "adapter",
        "plugin",
        "persistence",
        "browser",
        "nodejs",
        "indexeddb",
        "dexie",
        "pouchdb",
        "couchdb",
        "sqlite"
    ],
    "description": "Data abstraction layer that routes all database operations to any ORM or data store",
    "peerDependencies": {
        "@routier/core": ">=0.4.0"
    },
    "dependencies": {
        "@routier/memory-plugin": "^0.4.0"
    },
    "devDependencies": {
        "@routier/core": "^0.6.0",
        "@routier/test-utils": "^0.3.0",
        "@rspack/cli": "^1.1.8",
        "@rspack/core": "^1.1.8",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "module": "./dist/index.js"
}
