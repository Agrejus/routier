{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@routier/core": ["../../core/src/index.ts"],
            "@routier/core/*": ["../../core/src/*"],
            "@routier/datastore": ["../../datastore/src/index.ts"],
            "@routier/memory-plugin": ["../../plugins/memory/src/index.ts"],
            "@routier/react": ["../../react/src/index.ts"],
            "@routier/sql-plugin-core": ["../../plugins/sql-core/src/index.ts"],
            "@routier/postgres-plugin-core": ["../../plugins/postgres-core/src/index.ts"],
            "@routier/sqlite-plugin": ["../../plugins/sqlite/src/index.browser.ts"],
            "@routier/pglite-plugin": ["../../plugins/pglite/src/index.browser.ts"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
    // The two plugin paths above name the BROWSER entries. Both packages publish a node build and
    // a browser build, and TypeScript resolving by `exports` picks the node one, which has no
    // `wasmDriver`. Vite aliases the same two to their browser dist, so these keep the types
    // describing what actually runs.
}
