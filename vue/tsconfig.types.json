{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": true,
        "outDir": "dist",
        "noEmit": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
