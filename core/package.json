{
    "name": "@routier/core",
    "version": "0.7.0",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "source": "./src/index.ts",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist/**/*",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./utilities": {
            "types": "./dist/utilities/index.d.ts",
            "import": "./dist/utilities/index.js",
            "require": "./dist/utilities/index.cjs"
        },
        "./results": {
            "types": "./dist/results/index.d.ts",
            "import": "./dist/results/index.js",
            "require": "./dist/results/index.cjs"
        },
        "./schema": {
            "types": "./dist/schema/index.d.ts",
            "import": "./dist/schema/index.js",
            "require": "./dist/schema/index.cjs"
        },
        "./pipeline": {
            "types": "./dist/pipeline/index.d.ts",
            "import": "./dist/pipeline/index.js",
            "require": "./dist/pipeline/index.cjs"
        },
        "./collections": {
            "types": "./dist/collections/index.d.ts",
            "import": "./dist/collections/index.js",
            "require": "./dist/collections/index.cjs"
        },
        "./assertions": {
            "types": "./dist/assertions/index.d.ts",
            "import": "./dist/assertions/index.js",
            "require": "./dist/assertions/index.cjs"
        },
        "./plugins": {
            "types": "./dist/plugins/index.d.ts",
            "import": "./dist/plugins/index.js",
            "require": "./dist/plugins/index.cjs"
        },
        "./expressions": {
            "types": "./dist/expressions/index.d.ts",
            "import": "./dist/expressions/index.js",
            "require": "./dist/expressions/index.cjs"
        },
        "./errors": {
            "types": "./dist/errors/index.d.ts",
            "import": "./dist/errors/index.js",
            "require": "./dist/errors/index.cjs"
        },
        "./performance": {
            "types": "./dist/performance/index.d.ts",
            "import": "./dist/performance/index.js",
            "require": "./dist/performance/index.cjs"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/types/index.js",
            "require": "./dist/types/index.cjs"
        },
        "./transfer": {
            "types": "./dist/transfer/index.d.ts",
            "import": "./dist/transfer/index.js",
            "require": "./dist/transfer/index.cjs"
        }
    },
    "typesVersions": {
        "*": {
            "utilities": [
                "./dist/utilities/index.d.ts"
            ],
            "results": [
                "./dist/results/index.d.ts"
            ],
            "schema": [
                "./dist/schema/index.d.ts"
            ],
            "pipeline": [
                "./dist/pipeline/index.d.ts"
            ],
            "collections": [
                "./dist/collections/index.d.ts"
            ],
            "plugins": [
                "./dist/plugins/index.d.ts"
            ],
            "expressions": [
                "./dist/expressions/index.d.ts"
            ],
            "errors": [
                "./dist/errors/index.d.ts"
            ],
            "performance": [
                "./dist/performance/index.d.ts"
            ],
            "assertions": [
                "./dist/assertions/index.d.ts"
            ],
            "types": [
                "./dist/types/index.d.ts"
            ],
            "transfer": [
                "./dist/transfer/index.d.ts"
            ]
        }
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:bundle": "node ../scripts/clean-dist.mjs && rspack build",
        "build": "npm run build:bundle && npm run build:types",
        "tsc": "tsc --noEmit",
        "test": "jest",
        "lint": "oxlint . --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\" --ignore-pattern \"**/*.mjs\""
    },
    "sideEffects": false,
    "author": "James DeMeuse <james.demeuse@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Agrejus/routier.git",
        "directory": "core"
    },
    "keywords": [
        "orm",
        "typescript",
        "web",
        "indexeddb",
        "electron",
        "data access layer",
        "entities",
        "entity framework",
        "database"
    ],
    "description": "Core functionality for routier",
    "devDependencies": {
        "@rspack/cli": "^1.1.8",
        "@rspack/core": "^1.1.8",
        "typescript": "^5.7.2"
    },
    "module": "./dist/index.js"
}
