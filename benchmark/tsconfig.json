{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "strict": false,
        "paths": {
            "@routier/core": ["../core/src/index.ts"],
            "@routier/core/*": ["../core/src/*"],
            "@routier/datastore": ["../datastore/src/index.ts"],
            "@routier/memory-plugin": ["../plugins/memory/src/index.ts"]
        },
        "baseUrl": "."
    },
    "include": ["src/**/*.ts"]
}
