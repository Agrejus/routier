{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "core/src/index.ts",
        "datastore/src/index.ts",
        "react/src/index.ts",
        "plugins/blob/src/index.ts",
        "plugins/blob/src/stores/fileSystem.ts",
        "plugins/blob/src/stores/s3.ts",
        "plugins/browser-storage/src/index.ts",
        "plugins/dexie/src/index.ts",
        "plugins/encryption/src/index.ts",
        "plugins/file-system/src/index.ts",
        "plugins/memory/src/index.ts",
        "plugins/mongodb/src/index.ts",
        "plugins/mysql/src/index.ts",
        "plugins/otel/src/index.ts",
        "plugins/postgresql/src/index.ts",
        "plugins/pouchdb/src/index.ts",
        "plugins/replication/src/index.ts",
        "plugins/sql-core/src/index.ts",
        "plugins/sqlite/src/index.ts",
        "plugins/sqlite/src/drivers/sqlite3.ts",
        "plugins/sqlite/src/drivers/turso.ts",
        "plugins/sqlite/src/d1.ts"
    ],
    "out": "docs/reference/api",
    "entryPointStrategy": "expand",
    "tsconfig": "tsconfig.typedoc.json",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "readme": "none",
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "hideGenerator": true,
    "disableSources": false,
    "skipErrorChecking": true,
    "sort": [
        "source-order"
    ],
    "kindSortOrder": [
        "Project",
        "Module",
        "Namespace",
        "Enum",
        "Class",
        "Interface",
        "TypeAlias",
        "Function",
        "Variable"
    ]
}