{
    "name": "@routier/sqlite-plugin",
    "version": "0.4.1",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "source": "./src/index.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:bundle": "node ../../scripts/clean-dist.mjs && rspack build",
        "build": "npm run build:bundle && npm run build:types",
        "tsc": "tsc --noEmit",
        "test": "jest",
        "lint": "oxlint . --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\" --ignore-pattern \"**/*.mjs\""
    },
    "sideEffects": false,
    "author": "James DeMeuse <james.demeuse@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Agrejus/routier.git",
        "directory": "plugins/sqlite"
    },
    "keywords": [
        "orm",
        "typescript",
        "web",
        "indexeddb",
        "electron",
        "data access layer",
        "entities",
        "entity framework",
        "database"
    ],
    "description": "Dexie plugin for routier",
    "peerDependencies": {
        "@routier/core": ">=0.4.0",
        "@routier/sql-plugin-core": ">=0.4.0",
        "@sqlite.org/sqlite-wasm": ">=3.46.0",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.0.0",
        "@routier/core": "^0.5.0",
        "@routier/datastore": "^0.4.0",
        "@routier/sql-plugin-core": "^0.5.0",
        "@rspack/cli": "^1.1.8",
        "@rspack/core": "^1.1.8",
        "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
        "sqlite3": "^5.1.7"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "browser": {
                "types": "./dist/index.browser.d.ts",
                "import": "./dist/index.browser.js",
                "require": "./dist/index.browser.cjs"
            },
            "node": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "require": "./dist/index.cjs"
            },
            "default": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "require": "./dist/index.cjs"
            }
        },
        "./drivers/sqlite3": {
            "types": "./dist/drivers/sqlite3.d.ts",
            "import": "./dist/drivers/sqlite3.js",
            "require": "./dist/drivers/sqlite3.cjs"
        },
        "./package.json": "./package.json",
        "./drivers/turso": {
            "types": "./dist/drivers/turso.d.ts",
            "import": "./dist/drivers/turso.js",
            "require": "./dist/drivers/turso.cjs"
        },
        "./d1": {
            "types": "./dist/d1.d.ts",
            "import": "./dist/d1.js",
            "require": "./dist/d1.cjs"
        }
    },
    "module": "./dist/index.js",
    "browser": "./dist/index.browser.js",
    "peerDependenciesMeta": {
        "sqlite3": {
            "optional": true
        },
        "@sqlite.org/sqlite-wasm": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.5.0"
    }
}
