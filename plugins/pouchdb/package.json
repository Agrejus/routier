{
    "name": "@routier/pouchdb-plugin",
    "version": "0.5.0",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "source": "./src/index.ts",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:bundle": "node ../../scripts/clean-dist.mjs && rspack build",
        "build": "npm run build:bundle && npm run build:types",
        "tsc": "tsc --noEmit",
        "test": "vitest --run",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "lint": "oxlint . --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\" --ignore-pattern \"**/*.mjs\""
    },
    "sideEffects": false,
    "author": "James DeMeuse <james.demeuse@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Agrejus/routier.git",
        "directory": "plugins/pouchdb"
    },
    "keywords": [
        "orm",
        "typescript",
        "web",
        "indexeddb",
        "electron",
        "data access layer",
        "entities",
        "entity framework",
        "database"
    ],
    "description": "PouchDB plugin for routier",
    "dependencies": {
        "events": "^3.3.0"
    },
    "peerDependencies": {
        "@routier/core": ">=0.7.0",
        "pouchdb": ">=9.0.0"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.0.0",
        "@routier/core": "^0.7.0",
        "@routier/datastore": "^0.4.1",
        "@routier/memory-plugin": "file://../memory",
        "@routier/test-utils": "^0.3.0",
        "@rspack/cli": "^1.1.8",
        "@rspack/core": "^1.1.8",
        "@types/pouchdb": "^6.4.2"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "module": "./dist/index.js"
}
