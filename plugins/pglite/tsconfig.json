{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "module": "ESNext",
        "lib": [
            "ESNext",
            "ESNext.Disposable",
            "DOM"
        ],
        "target": "ESNext",
        "declaration": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "outDir": "./dist",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "baseUrl": "dist",
        "resolveJsonModule": true
    },
    "include": [
        "./src/index.ts",
        "./src/index.browser.ts",
        "./src/shared.ts",
        "./src/pgliteWorker.ts",
        "./src/browserStorage.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "./src/tests/**",
        "**/*.test.ts"
    ]
}
