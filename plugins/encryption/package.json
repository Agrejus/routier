{
    "name": "@routier/encryption",
    "version": "0.4.0",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "source": "./src/index.ts",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:bundle": "node ../../scripts/clean-dist.mjs && rspack build",
        "build": "npm run build:bundle && npm run build:types",
        "tsc": "tsc --noEmit",
        "test": "jest",
        "lint": "oxlint . --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.mjs\""
    },
    "sideEffects": false,
    "author": "James DeMeuse <james.demeuse@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Agrejus/routier.git",
        "directory": "plugins/encryption"
    },
    "keywords": [
        "routier",
        "encryption",
        "aes-gcm",
        "pii",
        "field level encryption",
        "schema transform"
    ],
    "description": "AES-GCM encryption as a Routier schema transform. Not a plugin: your database never sees it.",
    "peerDependencies": {
        "@routier/core": ">=0.7.0"
    },
    "devDependencies": {
        "@routier/core": "^0.7.0",
        "@routier/datastore": "^0.4.1",
        "@routier/memory-plugin": "^0.4.0",
        "@routier/dexie-plugin": "^0.4.2",
        "@rspack/cli": "^1.1.8",
        "@rspack/core": "^1.1.8"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    }
}
