{
    "name": "@routier/postgres-plugin-core",
    "version": "0.3.0",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "source": "./src/index.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "tsc": "tsc --noEmit",
        "test": "jest",
        "lint": "oxlint . --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\" --ignore-pattern \"**/*.mjs\"",
        "build:bundle": "node ../../scripts/clean-dist.mjs && rspack build",
        "build": "npm run build:bundle && npm run build:types"
    },
    "sideEffects": false,
    "author": "James DeMeuse <james.demeuse@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Agrejus/routier.git",
        "directory": "plugins/postgres-core"
    },
    "keywords": [
        "orm",
        "typescript",
        "postgresql",
        "postgres",
        "data access layer",
        "entities",
        "database",
        "routier"
    ],
    "description": "Engine-independent PostgreSQL building blocks for routier plugins: dialect, DDL, result translation, and a driver-shaped plugin base. Contains no database client.",
    "peerDependencies": {
        "@routier/core": ">=0.6.0",
        "@routier/sql-plugin-core": ">=0.6.0"
    },
    "devDependencies": {
        "@routier/core": "^0.6.0",
        "@routier/sql-plugin-core": "^0.6.0",
        "@rspack/cli": "^1.1.8",
        "@rspack/core": "^1.1.8"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "module": "./dist/index.js"
}
