{
    "name": "@routier/mysql-plugin",
    "version": "0.4.0",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "source": "./src/index.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:bundle": "node ../../scripts/clean-dist.mjs && rspack build",
        "build": "npm run build:bundle && npm run build:types",
        "tsc": "tsc --noEmit",
        "test": "jest",
        "lint": "oxlint . --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\" --ignore-pattern \"**/*.mjs\""
    },
    "sideEffects": false,
    "author": "James DeMeuse <james.demeuse@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Agrejus/routier.git",
        "directory": "plugins/mysql"
    },
    "keywords": [
        "orm",
        "typescript",
        "mysql",
        "mariadb",
        "data access layer",
        "entities",
        "entity framework",
        "database",
        "routier"
    ],
    "description": "MySQL plugin for Routier",
    "peerDependencies": {
        "@routier/core": ">=0.4.0",
        "@routier/sql-plugin-core": ">=0.4.0"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.0.0",
        "@routier/core": "^0.4.0",
        "@routier/datastore": "^0.4.0",
        "@rspack/cli": "^1.1.8",
        "@rspack/core": "^1.1.8",
        "@routier/sql-plugin-core": "^0.4.0"
    },
    "dependencies": {
        "mysql2": "^3.9.0"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "module": "./dist/index.js"
}
